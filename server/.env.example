# CampusHop API server — copy to .env and fill in.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase is the database. The client only talks to it to sign in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Paste the service_role key from Supabase -> Project Settings -> API.
# It bypasses row-level security, so it must never reach the browser.
# Until it is set, the server falls back to the anon key above.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouteService (free, 2000/day) computes and stores each ride's route.
# Server-side only.
ORS_API_KEY=

# Google Maps: Places + Geocoding. Server-side only — this key has quota
# and billing attached and must never reach the browser. Restrict it by
# IP in the Google Cloud console.
GOOGLE_MAPS_KEY=

# Where to bias address search. Defaults to Bengaluru.
# CITY_LAT=12.9716
# CITY_LON=77.5946
# SEARCH_RADIUS_KM=250

# --- Email notifications (optional) ---------------------------------
# Gmail over SMTP. Free, no domain to verify, ~500 messages a day.
# SMTP_PASS is a Google *App Password*, not your account password:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Leave these blank and notifications are simply off.
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER.
SMTP_FROM=

# Where the links in an email should point. APP_URL is the web app;
# API_URL is this server, and is what the Accept / Decline buttons hit.
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Signs the one-click Accept / Decline links. Any long random string.
# Changing it invalidates every link already sent.
ACTION_TOKEN_SECRET=

# Not using Gmail? Any SMTP provider works — no code change.
# Brevo:  smtp-relay.brevo.com : 587   (300 emails/day free)
# Resend: smtp.resend.com      : 587
# SMTP_HOST=
# SMTP_PORT=587
