# Copy this file to .env (client/.env) and fill in your own project values.
# Find these under Supabase Dashboard -> Project Settings -> API
# Only the URL and anon/public key go here. NEVER put the service_role key
# in client code or in a file that ships to the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
